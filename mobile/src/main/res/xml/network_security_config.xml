<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置：允许明文 HTTP 流量到自建服务器。
  其他域名默认仍走 HTTPS，不影响安全性。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
